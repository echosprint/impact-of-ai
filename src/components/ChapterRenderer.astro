---
import Note from './Note.astro';

export interface Props {
  chapterContent: string;
  rawContent: string;
}

const { chapterContent, rawContent } = Astro.props;
---

<div class="chapter-renderer">
  <div class="prose prose-xl prose-slate max-w-none" set:html={chapterContent} />
</div>

<style>
  .chapter-renderer {
    max-width: 4xl;
    margin: 0 auto;
  }
</style>
---
import { parseReferenceFile } from '../utils/notes-parser';
import { processMarkdownLinks, formatReferenceContent } from '../utils/markdown';
import NoteContent from './notes/NoteContent.astro';
import ReferenceCard from './references/ReferenceCard.astro';
import fs from 'fs';
import path from 'path';
import type { ComponentProps, ReferenceText } from '../types/references';

export interface Props extends ComponentProps {}

const { ref } = Astro.props;
const slots = await Astro.slots.render('default');

// Load references
let references = new Map<string, ReferenceText>();
try {
  const referenceFilePath = path.join(process.cwd(), 'src/content/reference.md');
  if (fs.existsSync(referenceFilePath)) {
    const referenceContent = fs.readFileSync(referenceFilePath, 'utf-8');
    references = parseReferenceFile(referenceContent);
  }
} catch (error) {
  console.error('Error loading references:', error);
}

const reference = references.get(ref);
---

<NoteContent noteId={ref} hasReference={!!reference}>
  <Fragment set:html={slots} />
</NoteContent>

<!-- Reference text for right column positioning -->
{reference && (
  <div 
    class="reference-for-positioning hidden" 
    data-note-id={ref}
    data-reference-content={JSON.stringify(reference)}
  >
    <ReferenceCard reference={reference} noteId={ref} />
  </div>
)}

<style>
  .note-inline-content {
    /* Notes flow as normal book content */
    margin: 0;
    transition: all 0.6s cubic-bezier(0.4, 0, 0.2, 1);
  }
  
  /* Inactive notes with references - show subtle clickable indicators */
  .note-inline-content[data-has-reference="true"]:not(.note-active) {
    position: relative;
    cursor: pointer;
    border-radius: 4px;
    transition: background 0.3s ease, box-shadow 0.3s ease;
  }
  
  .note-inline-content[data-has-reference="true"]:not(.note-active):hover {
    background: rgba(255, 251, 235, 0.3);
    box-shadow: 0 1px 3px rgba(139, 69, 19, 0.1);
    position: relative;
  }
  
  
  /* Connection indicators for inactive notes with references - using span elements */
  .connection-line {
    position: absolute;
    right: -9px;
    top: 50%;
    width: 9px;
    height: 1px;
    transform: translateY(-50%);
    background: repeating-linear-gradient(
      to right,
      rgba(139, 69, 19, 0.3) 0px,
      rgba(139, 69, 19, 0.3) 2px,
      transparent 2px,
      transparent 4px
    );
    pointer-events: none;
    opacity: 0.6;
    transition: opacity 0.3s ease;
  }
  
  .connection-circle {
    position: absolute;
    right: -15px;
    top: 50%;
    width: 6px;
    height: 6px;
    transform: translateY(-50%);
    background: transparent;
    border: 1px solid rgba(139, 69, 19, 0.4);
    border-radius: 50%;
    pointer-events: none;
    opacity: 0.6;
    transition: opacity 0.3s ease, border-color 0.3s ease, width 0.3s ease, height 0.3s ease;
  }
  
  /* Enhanced indicators on hover for inactive notes */
  .note-inline-content[data-has-reference="true"]:not(.note-active):hover .connection-line {
    opacity: 1;
    background: repeating-linear-gradient(
      to right,
      rgba(139, 69, 19, 0.6) 0px,
      rgba(139, 69, 19, 0.6) 2px,
      transparent 2px,
      transparent 4px
    );
  }
  
  .note-inline-content[data-has-reference="true"]:not(.note-active):hover .connection-circle {
    opacity: 1;
    border-color: rgba(139, 69, 19, 0.7);
    border-width: 2px;
    width: 8px;
    height: 8px;
    right: -16px;
  }
  
  /* Hide connection indicators for active notes (they use the ::before/::after from the active styles) */
  .note-inline-content.note-active .connection-line,
  .note-inline-content.note-active .connection-circle {
    display: none;
  }
  
  /* Clean paper-like selection for active note - no layout changes */
  .note-inline-content.note-active {
    position: relative;
    background: rgba(255, 251, 235, 0.7);
    border-radius: 4px;
    box-shadow: 
      0 1px 3px rgba(139, 69, 19, 0.06),
      0 0 0 1px rgba(139, 69, 19, 0.02);
    transition: background 0.5s cubic-bezier(0.25, 0.46, 0.45, 0.94),
                box-shadow 0.5s cubic-bezier(0.25, 0.46, 0.45, 0.94);
  }
  
  /* Connection line */
  .note-inline-content.note-active::before {
    content: '';
    position: absolute;
    right: -9px;
    top: 50%;
    width: 9px;
    height: 2px;
    transform: translateY(-50%);
    background: rgba(139, 69, 19, 0.6);
    pointer-events: none;
    opacity: 0;
    animation: fadeInLine 0.8s cubic-bezier(0.25, 0.46, 0.45, 0.94) 0.3s forwards;
  }
  
  /* Connection circle at end of line */
  .note-inline-content.note-active::after {
    content: '';
    position: absolute;
    right: -15px;
    top: 50%;
    width: 8px;
    height: 8px;
    transform: translateY(-50%);
    background: transparent;
    border: 2px solid rgba(139, 69, 19, 0.7);
    border-radius: 50%;
    pointer-events: none;
    opacity: 0;
    animation: fadeInCircle 0.6s cubic-bezier(0.25, 0.46, 0.45, 0.94) 0.6s forwards;
  }
  
  @keyframes fadeInLine {
    0% {
      opacity: 0;
      width: 4px;
    }
    100% {
      opacity: 1;
      width: 9px;
    }
  }
  
  @keyframes fadeInCircle {
    0% {
      opacity: 0;
      transform: translateY(-50%) scale(0.5);
    }
    100% {
      opacity: 1;
      transform: translateY(-50%) scale(1);
    }
  }
  
  .reference-wrapper {
    position: relative;
    width: 100%;
    height: 100%;
  }
  
  .reference-card {
    /* Enhanced styling for fixed position references */
    background: rgba(250, 248, 242, 0.96);
    border: 2px solid rgba(139, 69, 19, 0.2);
    box-shadow: 0 12px 48px rgba(139, 69, 19, 0.15), 0 4px 16px rgba(0, 0, 0, 0.1);
    transition: all 0.4s ease;
    backdrop-filter: blur(16px);
    border-radius: 16px;
    position: relative;
    overflow: hidden; /* Contain content within card boundaries */
    width: 100%; /* Use full assigned width */
    box-sizing: border-box;
    /* Dynamic height constraints */
    max-height: 70vh; /* Maximum 70% of viewport height */
    min-height: 120px; /* Minimum height for readability */
    /* Ensure hover area is active */
    cursor: default;
    pointer-events: auto;
  }
  
  
  /* Responsive adjustments for reference cards */
  @media (min-width: 1024px) {
    .reference-card {
      margin: 0;
      max-width: none;
    }
  }
  
  @media (max-width: 1023px) {
    .reference-card {
      margin: 0;
      max-width: none;
    }
    
    .reference-card :global(p.mixed-text) {
      font-size: 0.8rem !important;
    }
    
    .reference-card.expanded :global(p.mixed-text) {
      font-size: 0.9rem !important;
    }
  }
  
  @media (max-width: 640px) {
    .reference-card {
      border-radius: 12px;
      max-height: 60vh; /* Smaller max height on mobile */
    }
    
    .reference-card :global(p.mixed-text) {
      font-size: 0.75rem !important;
    }
    
    .reference-card.expanded :global(p.mixed-text) {
      font-size: 0.85rem !important;
    }
    
    .reference-content {
      max-height: calc(60vh - 60px) !important; /* Adjust for mobile header */
    }
    
    .reference-card.expanded {
      width: 125% !important; /* Reduced from 145% to 125% */
      max-width: 320px; /* Reduced maximum for mobile */
      transform: translateY(-5px) translateX(-20%); /* Removed scale for mobile */
    }
  }
  
  /* Tablet expand adjustments */
  @media (max-width: 1023px) and (min-width: 641px) {
    .reference-card.expanded {
      width: 135% !important; /* Reduced from 155% to 135% */
      max-width: 400px; /* Reduced maximum for tablet */
      transform: translateY(-6px) translateX(-26%); /* Removed scale for tablet */
    }
  }
  
  /* Connection line on reference wrapper - positioned outside card */
  .reference-wrapper::before {
    content: '';
    position: absolute;
    left: -10px;
    top: 50%;
    width: 8px;
    height: 2px;
    transform: translateY(-50%);
    background: rgba(139, 69, 19, 0.6);
    pointer-events: none;
    z-index: 10;
  }
  
  /* Connection circle on reference wrapper - positioned outside card */
  .reference-wrapper::after {
    content: '';
    position: absolute;
    left: -16px;
    top: 50%;
    width: 8px;
    height: 8px;
    transform: translateY(-50%);
    background: transparent;
    border: 2px solid rgba(139, 69, 19, 0.7);
    border-radius: 50%;
    pointer-events: none;
    z-index: 10;
  }
  
  .reference-card.expanded {
    background: rgba(250, 248, 242, 0.98);
    box-shadow: 0 24px 72px rgba(139, 69, 19, 0.3), 0 12px 32px rgba(0, 0, 0, 0.18);
    border-color: rgba(139, 69, 19, 0.5);
    transform: translateY(-8px) translateX(-50%); /* Removed scale to prevent reflow */
    width: 160% !important; /* Increased from 130% to 160% */
    max-width: 640px; /* Increased maximum width */
    z-index: 30 !important;
    transition: all 0.3s cubic-bezier(0.4, 0, 0.2, 1);
  }
  
  /* Ensure smooth transition for width changes */
  .reference-card {
    transition: all 0.3s cubic-bezier(0.4, 0, 0.2, 1);
  }
  
  .reference-card :global(p.mixed-text) {
    margin-bottom: 0.75rem;
    line-height: 1.6;
    color: #374151;
    font-size: 0.85rem;
    text-indent: 2em !important; /* Chinese paragraph indentation - override prose */
    transition: margin-bottom 0.3s ease;
  }
  
  .reference-card.expanded :global(p.mixed-text) {
    font-size: 1.0rem;
    line-height: 1.6;
    margin-bottom: 1rem; /* More space between paragraphs */
    text-indent: 2em !important; /* Chinese paragraph indentation - override prose */
  }
  
  .reference-card :global(p.mixed-text:last-child) {
    margin-bottom: 0;
  }
  
  .reference-card.expanded :global(p.mixed-text:last-child) {
    margin-bottom: 0;
  }
  
  /* Horizontal separator styling */
  .reference-card :global(hr.reference-separator) {
    border: none;
    height: 1px;
    background-color: #c4a882;
    margin: 1.5rem 1rem;
    opacity: 0.4;
  }
  
  .reference-card.expanded :global(hr.reference-separator) {
    margin: 2rem 1.5rem;
    opacity: 0.6;
  }
  
  /* Reference link styling */
  .reference-card :global(a.reference-link) {
    color: #d97706;
    text-decoration: none;
    border-bottom: 1px solid transparent;
    transition: all 0.2s ease;
    word-break: break-all;
    overflow-wrap: break-word;
    hyphens: auto;
  }
  
  .reference-card :global(a.reference-link:hover) {
    color: #b45309;
    border-bottom-color: #d97706;
  }
  
  .reference-card.expanded :global(a.reference-link) {
    color: #d97706;
  }
  
  .reference-card.expanded :global(a.reference-link:hover) {
    color: #92400e;
    border-bottom-color: #b45309;
  }
  
  /* Scrollable content area styling */
  .reference-content {
    /* Custom scrollbar for webkit browsers */
    scrollbar-width: thin;
    scrollbar-color: rgba(139, 69, 19, 0.3) transparent;
  }
  
  .reference-content::-webkit-scrollbar {
    width: 6px;
  }
  
  .reference-content::-webkit-scrollbar-track {
    background: transparent;
  }
  
  .reference-content::-webkit-scrollbar-thumb {
    background: rgba(139, 69, 19, 0.3);
    border-radius: 3px;
    transition: background 0.3s ease;
  }
  
  .reference-content::-webkit-scrollbar-thumb:hover {
    background: rgba(139, 69, 19, 0.5);
  }
  
  /* Enhanced header styling for scrollable references */
  .reference-header {
    backdrop-filter: blur(8px);
    border-radius: 16px 16px 0 0;
  }
  
  /* Subtle fade effect for scrollable content - reduced interference */
  .reference-content::before {
    content: '';
    position: sticky;
    top: 0;
    display: block;
    height: 6px;
    background: linear-gradient(to bottom, rgba(250, 248, 242, 0.4), transparent);
    margin: -3px -3px -6px -3px;
    pointer-events: none;
    z-index: 5;
  }
  
  .reference-content::after {
    content: '';
    position: sticky;
    bottom: 0;
    display: block;
    height: 12px;
    background: linear-gradient(to top, rgba(250, 248, 242, 0.8), transparent);
    margin: 0 -3px -3px -3px;
    pointer-events: none;
    z-index: 5;
  }
  
  /* Enhanced header styling - consistent size to prevent reflow */
  .reference-header span {
    font-size: 0.8125rem;
    color: #6b7280;
    font-weight: 500;
    transition: color 0.3s ease, font-weight 0.3s ease; /* Only animate color and weight */
  }
  
  /* Expand/collapse button styling */
  .expand-toggle {
    cursor: pointer;
    border: none;
    background: none;
    display: flex;
    align-items: center;
    justify-content: center;
    flex-shrink: 0;
  }
  
  .expand-toggle:focus {
    outline: none; /* Remove blue focus outline */
  }
  
  .expand-toggle:focus-visible {
    outline: 2px solid #d97706; /* Amber outline for keyboard navigation only */
    outline-offset: 2px;
  }
  
  .reference-card.expanded .reference-header span {
    font-size: 0.8125rem; /* Keep same size to prevent reflow */
    color: #6b7280; /* Keep original color when expanded */
    font-weight: 600; /* Bold when expanded */
  }
  
  /* Enhanced metadata styling - consistent size to prevent reflow */
  .reference-card div:last-child {
    padding-top: 0.75rem;
    font-size: 0.8125rem;
    transition: padding-top 0.3s ease; /* Only animate padding */
  }
  
  .reference-card div:last-child div {
    color: #4b5563;
    font-weight: 450;
    transition: color 0.3s ease, font-weight 0.3s ease; /* Only animate color and weight */
  }
  
  .reference-card.expanded div:last-child {
    padding-top: 1rem; /* More padding when expanded */
    font-size: 0.8125rem; /* Keep same size to prevent reflow */
  }
  
  .reference-card.expanded div:last-child div {
    color: #374151; /* Darker when expanded */
    font-weight: 500; /* Bold when expanded */
  }
  
  
  /* Smooth transitions for all notes */
  .note-inline-content {
    position: relative;
    transition: all 0.6s cubic-bezier(0.4, 0, 0.2, 1);
  }
  
  /* Enhanced transition for when note becomes active - no layout changes */
  .note-inline-content:not(.note-active) {
    background: transparent;
    box-shadow: none;
  }
</style>

<script>
  // Import the reference manager system
  import '../scripts/reference-manager';
</script>
---
import { getEntry, render } from 'astro:content';
import Note from '../components/Note.astro';
import { calculateWordCount, calculateReadingTime } from '../utils/markdown';
import type { ChapterData } from '../types/references';
import fs from 'fs';
import path from 'path';

export interface Props {
  chapter?: string;
}

const { chapter } = Astro.props;

// If no chapter is specified, show the preface
const targetChapter = chapter || 'preface';

let chapterData;
let Content;
let title;
let wordCount = 0;
let readingTime = 0;

try {
  // Get the chapter entry from the content collection
  chapterData = await getEntry('chapters', targetChapter);

  if (chapterData) {
    title = chapterData.data.title;

    // Calculate word count and reading time from the raw content
    wordCount = calculateWordCount(chapterData.body);
    readingTime = calculateReadingTime(wordCount);

    // Render the MDX content with components available
    const rendered = await render(chapterData);
    Content = rendered.Content;
  } else {
    // Fallback if chapter doesn't exist
    throw new Error(`Chapter "${targetChapter}" not found`);
  }
} catch (error) {
  console.error('Error loading chapter:', error);
  // Set fallback data
  chapterData = null;
  Content = null;
}


---

<h1 class="text-3xl md:text-4xl font-bold text-center mb-4 bg-gradient-to-r from-blue-600 to-purple-600 bg-clip-text text-transparent">{title}</h1>

<!-- Chapter metadata -->
{chapterData && (
  <div class="text-right mb-6">
    <div class="inline-flex items-center gap-2 text-xs text-slate-400 font-medium tracking-wide">
      <span>{wordCount.toLocaleString()} words</span>
      <span>•</span>
      <span>{readingTime} min read</span>
    </div>
  </div>
)}

<div class="prose prose-xl prose-slate max-w-none">
  <div class="book-content max-w-4xl mx-auto">
    {Content ? (
      <Content components={{ Note }} />
    ) : (
      <div class="text-center py-12">
        <h1 class="text-3xl font-bold text-red-600 mb-4">Content Not Found</h1>
        <p class="text-lg text-slate-600">
          The requested chapter could not be loaded. Please check the chapter name and try again.
        </p>
      </div>
    )}
  </div>
</div>

<style>
  .book-content {
    /* Enhanced typography for book reading */
    font-family: 'Noto Serif SC', 'Source Han Serif SC', 'Georgia', 'SimSun', 'Times New Roman', serif;
    line-height: 2.0;
    color: #1a202c;
    font-feature-settings: 'liga' 1, 'kern' 1, 'calt' 1;
    font-variant-numeric: oldstyle-nums;
  }
  
  .book-content :global(h1),
  .book-content :global(h2),
  .book-content :global(h3),
  .book-content :global(h4) {
    font-family: 'Inter', 'Noto Serif SC', 'SimSun', 'Helvetica Neue', sans-serif;
    letter-spacing: -0.03em;
    font-feature-settings: 'liga' 1, 'kern' 1;
    font-weight: 600;
  }
  
  .book-content :global(h1) {
    font-size: 3rem;
    font-weight: 700;
    color: #0f172a;
    margin-bottom: 3rem;
    line-height: 1.1;
    letter-spacing: -0.025em;
    text-align: center;
    background: linear-gradient(to right, #2563eb, #9333ea);
    background-clip: text;
    -webkit-background-clip: text;
    color: transparent;
  }
  
  .book-content :global(h2) {
    font-size: 1.75rem;
    font-weight: 600;
    color: #0f172a;
    margin-top: 2.5rem;
    margin-bottom: 1.25rem;
    line-height: 1.2;
    letter-spacing: -0.03em;
    padding-bottom: 0;
    position: relative;
  }

  .book-content :global(h2) :global(.section-number) {
    font-size: 1.4rem !important;
    font-weight: 600 !important;
    color: #0f172a !important;
    font-family: 'Inter', 'Noto Serif SC', 'SimSun', 'Helvetica Neue', sans-serif !important;
    letter-spacing: -0.03em !important;
    margin-right: 0.5rem !important;
  }
  
  .book-content :global(h3) {
    font-size: 1.625rem;
    font-weight: 700;
    color: #1e293b;
    margin-top: 3.5rem;
    margin-bottom: 2.2rem;
    line-height: 1.2;
    letter-spacing: -0.03em;
  }
  
  .book-content :global(h4) {
    font-size: 1.375rem;
    font-weight: 600;
    color: #334155;
    margin-top: 2.5rem;
    margin-bottom: 1.8rem;
    line-height: 1.2;
    letter-spacing: -0.03em;
  }
  
  .book-content :global(p) {
    margin-bottom: 2.2rem;
    color: #2d3748;
    line-height: 2.1;
    font-size: 1.125rem;
    font-weight: 400;
    letter-spacing: 0.03em;
    text-align: justify;
    hyphens: auto;
    text-indent: 2rem;
    word-spacing: 0.12em;
    orphans: 2;
    widows: 2;
  }
  
  .book-content :global(p:first-of-type),
  .book-content :global(h1 + p),
  .book-content :global(h2 + p),
  .book-content :global(h3 + p),
  .book-content :global(h4 + p) {
    text-indent: 0;
  }
  
  .book-content :global(strong) {
    font-weight: 600;
    color: #0f172a;
    letter-spacing: -0.01em;
  }
  
  .book-content :global(em) {
    font-style: italic;
    color: #2d3748;
    font-weight: 500;
    letter-spacing: 0.01em;
  }
  
  .book-content :global(ul),
  .book-content :global(ol) {
    margin: 2rem 0;
    padding-left: 0;
  }
  
  .book-content :global(li) {
    margin-bottom: 1rem;
    color: #374151;
    line-height: 1.7;
    padding-left: 1.5rem;
    position: relative;
  }
  
  .book-content :global(ul li)::before {
    content: '▸';
    color: #3b82f6;
    font-weight: 700;
    position: absolute;
    left: 0;
    top: 0;
  }
  
  .book-content :global(ol li) {
    list-style-type: decimal;
    list-style-position: inside;
  }
  
  .book-content :global(blockquote) {
    border-left: 4px solid #bfdbfe;
    padding-left: 1.5rem;
    margin-left: 0;
    font-style: italic;
    color: #475569;
    background-color: #eff6ff;
    padding-top: 1rem;
    padding-bottom: 1rem;
    border-radius: 0 0.5rem 0.5rem 0;
  }
  
  .book-content :global(code) {
    background-color: #f1f5f9;
    padding: 0.25rem 0.5rem;
    border-radius: 0.25rem;
    font-size: 0.875rem;
    font-family: 'Monaco', 'Menlo', 'Ubuntu Mono', monospace;
    color: #1e293b;
  }
  
  .book-content :global(pre) {
    background-color: #0f172a;
    color: #f1f5f9;
    padding: 1.5rem;
    border-radius: 0.5rem;
    overflow-x: auto;
    margin: 2rem 0;
  }
  
  .book-content :global(pre code) {
    background-color: transparent;
    padding: 0;
    color: #f1f5f9;
  }
  
  .book-content :global(a) {
    color: #2563eb;
    text-decoration: underline;
    transition: color 0.15s ease-in-out;
  }
  
  .book-content :global(a:hover) {
    color: #1e40af;
  }
  
  /* Improved readability on smaller screens */
  @media (max-width: 1024px) {
    .book-content {
      font-size: 17px;
      line-height: 1.9;
    }
    
    .book-content :global(p) {
      text-indent: 1.5rem;
      margin-bottom: 1.8rem;
      font-size: 1.0625rem;
      line-height: 1.9;
    }
    
    .book-content :global(h1) {
      font-size: 2rem;
      margin-bottom: 2.5rem;
    }
    
    .book-content :global(h2) {
      font-size: 1.5rem;
      margin-top: 2.5rem;
      margin-bottom: 1.25rem;
    }

    .book-content :global(h2 .section-number) {
      font-size: 1.2rem;
    }
    
    .book-content :global(h3) {
      font-size: 1.375rem;
      margin-top: 2.5rem;
      margin-bottom: 1.5rem;
    }
  }
  
  @media (max-width: 640px) {
    .book-content {
      font-size: 16px;
      line-height: 1.8;
    }
    
    .book-content :global(p) {
      text-indent: 1.2rem;
      margin-bottom: 1.6rem;
      font-size: 1rem;
      line-height: 1.8;
    }
  }
  
  /* Enhanced focus for accessibility */
  .book-content :global(*:focus) {
    outline: 2px solid #3b82f6;
    outline-offset: 2px;
    border-radius: 4px;
  }
</style> 
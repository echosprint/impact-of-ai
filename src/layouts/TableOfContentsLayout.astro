---
import { getCollection } from 'astro:content';

export interface Props {
  currentChapter?: string;
  bookTitle?: string;
}

const { currentChapter, bookTitle } = Astro.props;

// Get all chapters from the content collection
let chapters: Array<{ fileName: string; title: string; chapter: number }> = [];

try {
  const allChapters = await getCollection('chapters');
  
  // Transform the collection data to match our component's needs
  chapters = allChapters.map(chapter => ({
    fileName: chapter.slug,
    title: chapter.data.title,
    chapter: chapter.data.chapter,
  }));

  // Sort chapters by chapter number
  chapters.sort((a, b) => a.chapter - b.chapter);
} catch (error) {
  console.error('Error loading chapters from content collection:', error);
}
---

<div class="relative bg-gradient-to-br from-white/60 via-slate-50/40 to-white/60 backdrop-blur-md border border-white/20 rounded-xl shadow-sm shadow-slate-200/50 overflow-hidden flex flex-col h-[calc(100vh-4rem)] max-h-[calc(100vh-4rem)] lg:max-h-[calc(100vh-6rem)]">
  <!-- Fixed Header -->
  <div class="flex-shrink-0 p-4 lg:p-5 pb-2 lg:pb-3">
    <h1 class="text-sm lg:text-base font-medium text-slate-800 mb-2">{bookTitle}</h1>
    <div class="w-12 h-px bg-gradient-to-r from-slate-300/60 to-transparent rounded-full"></div>
  </div>
  
  <!-- Scrollable Navigation -->
  <nav class="flex-1 overflow-y-auto px-4 lg:px-5 pb-4 lg:pb-5">
    <ul class="space-y-0 toc-list">
      {chapters.map(({ fileName, title, chapter }) => (
        <li class="border-b border-slate-100/50 last:border-b-0">
          <a 
            href={`${import.meta.env.BASE_URL}/${fileName}`}
            class={`block px-3 py-1.5 text-sm transition-all duration-300 group relative hover:bg-gradient-to-r hover:from-blue-50/60 hover:to-white hover:shadow-lg hover:shadow-blue-100/40 ${
              currentChapter === fileName 
                ? 'text-blue-900 bg-gradient-to-r from-blue-50/80 to-blue-100/60 font-medium shadow-sm border-l-2 border-blue-500' 
                : 'text-slate-600 hover:text-blue-700'
            }`}
          >
            <div class="text-sm leading-tight flex" title={`${chapter}. ${title}`}>
              <span class={`font-medium w-8 flex-shrink-0 ${
                currentChapter === fileName 
                  ? 'text-blue-600' 
                  : 'text-slate-500'
              }`}>{chapter}.</span>
              <span class="flex-1">{title}</span>
            </div>
          </a>
        </li>
      ))}
    </ul>
  </nav>
  
  <!-- Subtle decorative elements -->
  <div class="absolute -top-2 -right-2 w-16 h-16 bg-gradient-to-br from-blue-100/30 to-purple-100/30 rounded-full blur-xl"></div>
  <div class="absolute -bottom-4 -left-4 w-20 h-20 bg-gradient-to-tl from-slate-100/40 to-blue-50/30 rounded-full blur-2xl"></div>
  
  <!-- Paper-like texture overlay -->
  <div class="absolute inset-0 bg-gradient-to-br from-transparent via-white/5 to-transparent pointer-events-none"></div>
</div>

<style>
  /* Custom scrollbar styling for table of contents */
  nav {
    /* Custom scrollbar for webkit browsers */
    scrollbar-width: thin;
    scrollbar-color: rgba(59, 130, 246, 0.2) transparent;
  }
  
  nav::-webkit-scrollbar {
    width: 6px;
  }
  
  nav::-webkit-scrollbar-track {
    background: transparent;
  }
  
  nav::-webkit-scrollbar-thumb {
    background: rgba(59, 130, 246, 0.2);
    border-radius: 3px;
    transition: background 0.3s ease;
  }
  
  nav::-webkit-scrollbar-thumb:hover {
    background: rgba(59, 130, 246, 0.4);
  }
  
  /* Fade effects to indicate scrollable content */
  nav::before {
    content: '';
    position: sticky;
    top: 0;
    left: 0;
    right: 0;
    height: 12px;
    background: linear-gradient(to bottom, rgba(255, 255, 255, 0.9), transparent);
    z-index: 10;
    pointer-events: none;
    margin: 0 -1.25rem -12px -1.25rem;
  }
  
  nav::after {
    content: '';
    position: sticky;
    bottom: 0;
    left: 0;
    right: 0;
    height: 12px;
    background: linear-gradient(to top, rgba(255, 255, 255, 0.9), transparent);
    z-index: 10;
    pointer-events: none;
    margin: -12px -1.25rem 0 -1.25rem;
  }
  
  /* Smooth scrolling behavior */
  nav {
    scroll-behavior: smooth;
  }
  
  /* Enhanced hover states for better UX when scrolling */
  .toc-list li a:hover {
    transform: translateY(-1px);
  }
  
  /* Mobile scroll optimization */
  @media (max-width: 1023px) {
    nav {
      -webkit-overflow-scrolling: touch; /* Smooth scrolling on iOS */
    }
  }
</style> 
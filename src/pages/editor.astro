---
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout 
  title="Writer - AI Impact"
  description="Simple writing editor for book chapters"
>
  <!-- Fixed header -->
  <header class="fixed top-0 left-0 right-0 bg-white/80 backdrop-blur-sm border-b border-gray-200 z-10">
    <div class="max-w-4xl mx-auto px-6 py-4 flex items-center justify-between">
      <div class="flex items-center gap-4">
        <select 
          id="fileSelect" 
          name="filename" 
          class="text-sm border-none bg-transparent focus:outline-none text-gray-600"
          required
        >
          <option value="">Select chapter...</option>
        </select>
      </div>
      
      <div class="flex items-center gap-3">
        <button 
          type="submit" 
          form="editorForm"
          class="bg-green-600 hover:bg-green-700 text-white text-sm px-4 py-2 rounded-full transition-colors"
        >
          Publish
        </button>
      </div>
    </div>
  </header>

  <!-- Writing area -->
  <main class="pt-20 min-h-screen bg-white">
    <div class="max-w-7xl mx-auto px-6 py-12">
      <form id="editorForm" class="grid grid-cols-1 lg:grid-cols-2 gap-8">
        <!-- Writing Section -->
        <div>
          <textarea 
            id="contentArea" 
            name="content" 
            class="w-full min-h-[200px] resize-none border border-gray-200 rounded-lg p-4 outline-none text-lg leading-relaxed placeholder-gray-400 focus:border-green-500 focus:ring-1 focus:ring-green-500"
            placeholder="Start writing your content here..."
            required
            style="font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', 'PingFang SC', 'Hiragino Sans GB', 'Microsoft YaHei', 'Helvetica Neue', Arial, sans-serif; overflow: hidden;"
          ></textarea>
        </div>

        <!-- Reference Section -->
        <div>
          <textarea 
            id="referenceArea" 
            name="reference" 
            class="w-full min-h-[200px] resize-none border border-gray-200 rounded-lg p-4 outline-none text-base leading-relaxed placeholder-gray-400 focus:border-blue-500 focus:ring-1 focus:ring-blue-500"
            placeholder="Paste reference materials, quotes, or research notes here..."
            style="font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', 'PingFang SC', 'Hiragino Sans GB', 'Microsoft YaHei', 'Helvetica Neue', Arial, sans-serif; background-color: #fafafa; overflow: hidden;"
          ></textarea>
        </div>
      </form>
    </div>
  </main>

  <!-- Toast message -->
  <div id="message" class="fixed bottom-6 left-1/2 transform -translate-x-1/2 px-4 py-2 rounded-full shadow-lg transition-all duration-300 opacity-0 pointer-events-none">
  </div>

  <script>
    // Load available files
    async function loadFiles() {
      try {
        const response = await fetch('/api/files');
        const data = await response.json();
        
        const select = document.getElementById('fileSelect') as HTMLSelectElement;
        select.innerHTML = '<option value="">Select chapter...</option>';
        
        data.files.forEach((file: string) => {
          const option = document.createElement('option');
          option.value = file;
          option.textContent = file.replace(/\.(md|mdx)$/, '');
          select.appendChild(option);
        });

        // Auto-select the most recently modified file
        if (data.lastModified) {
          select.value = data.lastModified;
        }
      } catch (error) {
        showMessage('Failed to load files', 'error');
      }
    }

    // Show toast message
    function showMessage(text: string, type: 'success' | 'error') {
      const messageEl = document.getElementById('message')!;
      messageEl.className = `fixed bottom-6 left-1/2 transform -translate-x-1/2 px-4 py-2 rounded-full shadow-lg transition-all duration-300 text-sm ${
        type === 'success' 
          ? 'bg-green-600 text-white' 
          : 'bg-red-600 text-white'
      }`;
      messageEl.textContent = text;
      messageEl.style.opacity = '1';
      messageEl.style.pointerEvents = 'auto';
      
      setTimeout(() => {
        messageEl.style.opacity = '0';
        messageEl.style.pointerEvents = 'none';
      }, 3000);
    }

    // Auto-resize textarea
    function autoResize(textarea: HTMLTextAreaElement) {
      textarea.style.height = 'auto';
      textarea.style.height = Math.max(textarea.scrollHeight, 200) + 'px';
    }

    // Initialize auto-resize on load
    function initializeTextareas() {
      const contentArea = document.getElementById('contentArea') as HTMLTextAreaElement;
      const referenceArea = document.getElementById('referenceArea') as HTMLTextAreaElement;
      autoResize(contentArea);
      autoResize(referenceArea);
    }

    // Handle form submission
    document.getElementById('editorForm')!.addEventListener('submit', async (e) => {
      e.preventDefault();
      
      const select = document.getElementById('fileSelect') as HTMLSelectElement;
      const contentArea = document.getElementById('contentArea') as HTMLTextAreaElement;
      const referenceArea = document.getElementById('referenceArea') as HTMLTextAreaElement;
      
      const filename = select.value;
      const content = contentArea.value;
      const reference = referenceArea.value;
      
      if (!filename || !content.trim()) {
        showMessage('Please select a file and enter content', 'error');
        return;
      }

      // Format as Note component
      let finalContent;
      if (reference.trim()) {
        // Extract source from reference (usually last paragraph)
        const referenceLines = reference.trim().split('\n').filter(line => line.trim());
        const source = referenceLines[referenceLines.length - 1];
        const referenceContent = referenceLines.slice(0, -1).join('\n');
        
        finalContent = `<Note>\n${content.trim()}\n///\n${referenceContent}\n///\n${source}\n</Note>`;
      } else {
        finalContent = `<Note>\n${content.trim()}\n</Note>`;
      }

      // Disable submit button temporarily
      const submitBtn = document.querySelector('button[type="submit"]') as HTMLButtonElement;
      const originalText = submitBtn.textContent;
      submitBtn.textContent = 'Publishing...';
      submitBtn.disabled = true;

      try {
        const response = await fetch('/api/append', {
          method: 'POST',
          headers: {
            'Content-Type': 'application/json'
          },
          body: JSON.stringify({ filename, content: finalContent })
        });

        const result = await response.json();
        
        if (result.success) {
          showMessage('Content published successfully', 'success');
          contentArea.value = '';
          referenceArea.value = '';
          autoResize(contentArea);
          autoResize(referenceArea);
        } else {
          showMessage(result.error || 'Failed to publish', 'error');
        }
      } catch (error) {
        showMessage('Network error, please try again', 'error');
      } finally {
        submitBtn.textContent = originalText;
        submitBtn.disabled = false;
      }
    });


    // Auto-resize on input for both textareas
    document.getElementById('contentArea')!.addEventListener('input', (e) => {
      autoResize(e.target as HTMLTextAreaElement);
    });

    document.getElementById('referenceArea')!.addEventListener('input', (e) => {
      autoResize(e.target as HTMLTextAreaElement);
    });

    // Focus content textarea and initialize on load
    window.addEventListener('load', () => {
      initializeTextareas();
      document.getElementById('contentArea')!.focus();
    });

    // Load files on page load
    loadFiles();
  </script>
</BaseLayout>